# =============================================================================
# Gestor Inteligente de Finanzas Personales — variables de entorno
#
# Copiá este archivo a `.env` y completá los valores.
#   cp .env.example .env
#
# NUNCA commitees el archivo `.env`. Todos los valores de acá son dummy.
# =============================================================================

# --- Base de datos ----------------------------------------------------------
MYSQL_ROOT_PASSWORD=cambiame_root
MYSQL_DATABASE=finanzas
MYSQL_USER=finanzas
MYSQL_PASSWORD=cambiame_app
MYSQL_PORT=3306

# URL que usa el backend. El host `db` es el nombre del servicio en docker compose.
DATABASE_URL=mysql+aiomysql://finanzas:cambiame_app@db:3306/finanzas?charset=utf8mb4

# --- Seguridad / JWT --------------------------------------------------------
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=cambiame_por_una_clave_larga_y_aleatoria
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Parámetros de Argon2id. Los defaults siguen la recomendación de OWASP.
# En producción la app se niega a arrancar con valores por debajo del mínimo:
# el hashing es caro a propósito y abaratarlo debilita todas las contraseñas.
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST_KIB=65536
ARGON2_PARALLELISM=4

# --- OpenAI / Asistente -----------------------------------------------------
# La API key vive SOLO acá, en el backend. Jamás en el frontend ni en el repo.
OPENAI_API_KEY=sk-dummy-reemplazar
# Escalón "mini". Verificar el identificador exacto y el precio vigente en
# https://platform.openai.com/pricing antes de fijarlo.
OPENAI_MODEL=gpt-5-mini
OPENAI_MAX_TOKENS=500
OPENAI_TIMEOUT_SECONDS=30

# Guardrails del agente. AGENT_MAX_ITERATIONS es el crítico: sin tope, el agente
# puede entrar en loop tool -> modelo -> tool y disparar decenas de llamadas.
AGENT_MAX_ITERATIONS=3
CHAT_HISTORY_WINDOW=6
CHAT_RATE_LIMIT_PER_HOUR=20

# --- Movimientos recurrentes ------------------------------------------------
# Hora (0-23) a la que corre el job diario, en APP_TIMEZONE.
RECURRING_JOB_HOUR=3
# Tope de días hacia atrás al hacer catch-up tras una caída prolongada.
RECURRING_CATCHUP_MAX_DAYS=90

# --- Localización -----------------------------------------------------------
# Zona horaria única de toda la aplicación (decisión cerrada, ver docs/PROMPT.md §5.2).
APP_TIMEZONE=America/Argentina/Buenos_Aires
# Moneda única en v1. Preparado para ARS,USD pero USD NO está habilitado.
DEFAULT_CURRENCY=ARS
SUPPORTED_CURRENCIES=ARS

# --- Aplicación -------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
# Orígenes permitidos por CORS, separados por coma.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- Puertos expuestos en el host -------------------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=8080
